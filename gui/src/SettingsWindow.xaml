<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="SettingsRoot" Width="760">

    <StackPanel Margin="22,20,22,18">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Ayarlar" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="SettingsSubtitle" Text="WarpCord" FontSize="11.5" Margin="0,4,0,0"
                           Foreground="{StaticResource TextFaintBrush}"/>
            </StackPanel>
            <Button x:Name="SettingsClose" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Kapat"
                    Width="96" Height="32" VerticalAlignment="Top"/>
        </Grid>

        <Border Style="{StaticResource SegmentedHost}" Margin="0,16,0,0" HorizontalAlignment="Left" Padding="2">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabGeneral" Style="{StaticResource SegmentRadio}" Content="Genel"
                             GroupName="SettingsTab" IsChecked="True" Height="28"/>
                <RadioButton x:Name="TabReadiness" Style="{StaticResource SegmentRadio}" Content="Hazırlık"
                             GroupName="SettingsTab" Height="28"/>
                <RadioButton x:Name="TabEndpoints" Style="{StaticResource SegmentRadio}" Content="Uçlar"
                             GroupName="SettingsTab" Height="28"/>
                <RadioButton x:Name="TabAbout" Style="{StaticResource SegmentRadio}" Content="Hakkında"
                             GroupName="SettingsTab" Height="28"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,16,0,0" Height="560">

            <!-- General -->
            <StackPanel x:Name="PanelGeneral">
                <TextBlock Style="{StaticResource SectionLabel}" Text="Dil"/>
                <Border Style="{StaticResource SegmentedHost}" Margin="0,7,0,0" HorizontalAlignment="Left" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LanguageTr" Style="{StaticResource SegmentRadio}" Content="Türkçe"
                                     GroupName="Language" Height="28"/>
                        <RadioButton x:Name="LanguageEn" Style="{StaticResource SegmentRadio}" Content="İngilizce"
                                     GroupName="Language" Height="28"/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="SwitchTray" Style="{StaticResource SwitchCheck}" Margin="0,18,0,0"
                          Content="Tepsi simgesi"/>
                <CheckBox x:Name="SwitchNotify" Style="{StaticResource SwitchCheck}" Margin="0,12,0,0"
                          Content="Bildirimler"/>
                <CheckBox x:Name="SwitchMinimize" Style="{StaticResource SwitchCheck}" Margin="0,12,0,0"
                          Content="Küçültünce tepsiye in"/>
                <CheckBox x:Name="SwitchAutoHeal" Style="{StaticResource SwitchCheck}" Margin="0,12,0,0"
                          Content="Otomatik onarım"/>
                <TextBlock x:Name="AutoHealNote" Style="{StaticResource Faint}" Margin="44,6,0,0"
                           Text="Sorun görüldüğünde onarımı kendisi çalıştırır."/>

                <Border Style="{StaticResource Divider}" Margin="0,18,0,14"/>
                <TextBlock Style="{StaticResource SectionLabel}" Text="Taşınabilir mod"/>
                <TextBlock x:Name="PortableNote" Style="{StaticResource Faint}" Margin="0,7,0,0" LineHeight="17"
                           Text=""/>
                <TextBlock x:Name="SettingsPathNote" Style="{StaticResource Faint}" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                           Foreground="{StaticResource TextFaintBrush}"/>
                <TextBlock x:Name="EngineNote" Style="{StaticResource Faint}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                           Foreground="{StaticResource TextFaintBrush}"/>

                <Border Style="{StaticResource Divider}" Margin="0,14,0,10"/>
                <TextBlock x:Name="SacNote" Style="{StaticResource Faint}" TextWrapping="Wrap" LineHeight="17" Text=""/>
                <Button x:Name="SacBtn" Style="{StaticResource GhostButton}" Content="SAC-güvenli modu aç"
                        Width="230" Margin="0,10,0,0" HorizontalAlignment="Left"/>

                <Border Style="{StaticResource Divider}" Margin="0,16,0,12"/>
                <TextBlock Style="{StaticResource SectionLabel}" Text="KURULUM"/>
                <TextBlock x:Name="InstallNote" Style="{StaticResource Faint}" Margin="0,7,0,0" LineHeight="17"
                           TextWrapping="Wrap" Text=""/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="InstallBtn" Style="{StaticResource GhostButton}" Content="Bu makineye kur" Width="160"/>
                    <Button x:Name="RemoveInstallBtn" Style="{StaticResource GhostButton}" Content="Kaldır" Width="100"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Readiness -->
            <StackPanel x:Name="PanelReadiness" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Faint}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Hazırlık denetimi bu makinede kurulumu engelleyen bir şey var mı diye bakar."/>
                    <Button x:Name="ReadinessBtn" Grid.Column="1" Style="{StaticResource GhostButton}"
                            Content="Denetle" Width="110" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock x:Name="ReadinessStatus" Style="{StaticResource Faint}" Margin="0,10,0,0" Text=""/>
                <StackPanel x:Name="ReadinessList" Margin="0,8,0,0"/>
                <TextBlock x:Name="ReadinessHint" Style="{StaticResource Faint}" Margin="0,10,0,0" LineHeight="17"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Endpoints -->
            <StackPanel x:Name="PanelEndpoints" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Faint}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Her aday, Discord API'sine gerçek bir istekle denenir."/>
                    <Button x:Name="EndpointsBtn" Grid.Column="1" Style="{StaticResource GhostButton}"
                            Content="Uçları dene" Width="120" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock x:Name="EndpointsStatus" Style="{StaticResource Faint}" Margin="0,10,0,0" Text=""/>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="8" Background="#FF0C0F1A">
                    <ListBox x:Name="EndpointsList" Background="Transparent" BorderThickness="0" Height="196"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" CornerRadius="7" Padding="10,6" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelHiBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#FF232B44"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Latency}" Margin="12,0,0,0" FontSize="11.5"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6" Margin="10,0,2,0" VerticalAlignment="Center"
                                             Fill="{Binding Dot}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="UseBestBtn" Style="{StaticResource GhostButton}" Content="En iyisini kullan"
                            Width="150"/>
                    <Button x:Name="UseSelectedBtn" Style="{StaticResource GhostButton}" Content="Bu ucu kullan"
                            Width="140" Margin="8,0,0,0"/>
                    <TextBlock x:Name="EndpointNote" Style="{StaticResource Faint}" Margin="12,0,0,0"
                               VerticalAlignment="Center" Text=""/>
                </StackPanel>
            </StackPanel>

            <!-- About -->
            <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Arayüz" Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AboutUi" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Grid.Row="1" Text="Tünel" Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AboutTunnel" Grid.Row="1" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Grid.Row="2" Text="Depo" Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AboutRepo" Grid.Row="2" Grid.Column="1" FontSize="11.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Row="3" Text="Motor" Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AboutSource" Grid.Row="3" Grid.Column="1" FontSize="11.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Row="4" Text="Sürüm" Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AboutUpdate" Grid.Row="4" Grid.Column="1" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Row="5" Text="İmza" Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AboutSignature" Grid.Row="5" Grid.Column="1" FontSize="11.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDimBrush}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="UpdateBtn" Style="{StaticResource GhostButton}" Content="Sürümü denetle" Width="140"/>
                    <Button x:Name="DownloadBtn" Style="{StaticResource GhostButton}" Content="İndir" Width="100"
                            Margin="8,0,0,0" Visibility="Collapsed"/>
                    <Button x:Name="BundleBtn" Style="{StaticResource GhostButton}" Content="Tanı paketi" Width="130"
                            Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="AboutStatus" Style="{StaticResource Faint}" Margin="0,12,0,0" LineHeight="17"
                           TextWrapping="Wrap" Text=""/>
                <TextBlock x:Name="AboutLink" Margin="0,8,0,0" FontSize="11.5" Foreground="{StaticResource CyanBrush}"
                           Cursor="Hand" Visibility="Collapsed" Text="github.com/Edipcm-hash/warpcord"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Grid>
