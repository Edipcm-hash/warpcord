<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PromptRoot" Width="520">

    <StackPanel Margin="24,22,24,18">

        <TextBlock Text="Kurulum yöntemi" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                   Foreground="{StaticResource TextDimBrush}"
                   Text="İki yol da aynı tüneli kurar; yalnızca kurulumun nerede çalıştığı değişir."/>

        <Button x:Name="UseAppBtn" Style="{StaticResource GhostButton}" Height="Auto" Margin="0,18,0,0"
                HorizontalContentAlignment="Stretch" Cursor="Hand">
            <Grid Margin="16,13,16,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Uygulama ile kur" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                               Foreground="{StaticResource TextFaintBrush}"
                               Text="Adımları bu pencerede canlı görürsün; kurulum çıktısı kaydın içinde kalır."/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="8,3,9,3" Margin="10,0,0,0"
                        VerticalAlignment="Top" Background="#1634D399" BorderBrush="#3834D399">
                    <TextBlock Text="ÖNERİLEN" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource GreenBrush}"/>
                </Border>
            </Grid>
        </Button>

        <Button x:Name="UseManualBtn" Style="{StaticResource GhostButton}" Height="Auto" Margin="0,10,0,0"
                HorizontalContentAlignment="Stretch" Cursor="Hand">
            <Grid Margin="16,13,16,13">
                <StackPanel>
                    <TextBlock Text="Elle kur — WarpCord.bat" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                               Foreground="{StaticResource TextFaintBrush}"
                               Text="Klasik kurulum ayrı bir komut penceresinde çalışır; UAC istemi orada çıkar. Uygulama açık kalır ve durumu izlemeye devam eder."/>
                </StackPanel>
            </Grid>
        </Button>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource TextFaintBrush}"
                       Text="Seçimini sonra Gelişmiş bölümünden değiştirebilirsin."/>
            <Button x:Name="CancelBtn" Grid.Column="1" Style="{StaticResource LinkButton}" Content="Vazgeç"
                    Margin="12,0,0,0"/>
        </Grid>
    </StackPanel>
</Grid>
