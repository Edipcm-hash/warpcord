<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:WarpCord;assembly=WarpCord"
      x:Name="Root">

    <Border x:Name="RootBorder" BorderBrush="#FF232A40" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ==================================================== title bar -->
            <Grid x:Name="TitleBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="TitleLogo" Width="19" Height="19" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="WarpCord" Margin="9,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <Border Width="1" Height="13" Background="{StaticResource StrokeBrush}" Margin="11,0,11,0"/>
                    <TextBlock Text="Discord'a özel split tunnel" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{StaticResource TextFaintBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Button x:Name="SettingsBtn" Style="{StaticResource TitleButton}" ToolTip="Ayarlar">
                        <TextBlock Text="&#x2699;" FontSize="13.5" FontFamily="Segoe UI Symbol, Segoe UI"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="MinBtn" Style="{StaticResource TitleButton}" ToolTip="Küçült">
                        <Path Data="M 0,0 L 11,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource TitleButton}" ToolTip="Büyüt">
                        <Path x:Name="MaxIcon" Data="M 0.5,0.5 L 10.5,0.5 L 10.5,10.5 L 0.5,10.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1"/>
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}" ToolTip="Kapat" Margin="2,0,0,0">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========================================================= body -->
            <Grid Grid.Row="1" Margin="18,4,18,12" MaxWidth="1440" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Smart App Control blocks unsigned binaries; hidden unless it is on -->
                    <Border x:Name="SacBanner" Visibility="Collapsed" CornerRadius="12" Margin="0,0,0,12"
                            Padding="14,11" Background="#14FBBF24" BorderBrush="#38FBBF24" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SacBannerText" VerticalAlignment="Center" FontSize="12.5"
                                       TextWrapping="Wrap" Foreground="#FFF2D08A"
                                       Text="Smart App Control açık: imzasız bileşenler bu makinede engellenir."/>
                            <Button x:Name="SacHelpBtn" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Content="Nasıl kapatılır?" Height="32" Margin="14,0,0,0" Padding="14,0"/>
                        </Grid>
                    </Border>

                    <!-- elevation hint, hidden unless the UI is not elevated -->
                    <Border x:Name="AdminBanner" Visibility="Collapsed" CornerRadius="12" Margin="0,8,0,12"
                            Padding="14,11" Background="#14FBBF24" BorderBrush="#38FBBF24" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AdminBannerText" VerticalAlignment="Center" FontSize="12.5"
                                       TextWrapping="Wrap" Foreground="#FFF2D08A"
                                       Text="Kurulum ve onarım için yönetici hakları gerekiyor."/>
                            <Button x:Name="AdminFixBtn" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Content="Yönetici olarak yeniden başlat" Height="32" Margin="14,0,0,0" Padding="14,0"/>
                        </Grid>
                    </Border>

                    <!-- network changed, hidden until the adapter list changes -->
                    <Border x:Name="NetworkBanner" Visibility="Collapsed" CornerRadius="12" Margin="0,8,0,12"
                            Padding="14,11" Background="#1422D3EE" BorderBrush="#3822D3EE" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NetworkBannerText" VerticalAlignment="Center" FontSize="12.5"
                                       TextWrapping="Wrap" Foreground="#FFA5E7F5"
                                       Text="Ağ değişti: DNS ve tünel yenilenmeli."/>
                            <Button x:Name="NetworkFixBtn" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Content="Yeniden Bağlan" Height="32" Margin="14,0,0,0" Padding="14,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="416"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- === left column === -->
                    <ScrollViewer x:Name="LeftScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,4,0" MinHeight="{Binding ViewportHeight, ElementName=LeftScroll}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="HeroCard" Style="{StaticResource Card}">
                                <StackPanel Margin="20,20,20,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="HeroLogo" Width="62" Height="62" VerticalAlignment="Top"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Effect>
                                                <DropShadowEffect Color="#FF22D3EE" BlurRadius="30" ShadowDepth="0"
                                                                  Opacity="0.45"/>
                                            </Image.Effect>
                                        </Image>
                                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource H1}" Text="WarpCord"/>
                                            <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0"
                                                       Text="Sadece Discord trafiği tünele girer, geri kalan her şey doğrudan gider."/>
                                        </StackPanel>
                                    </Grid>

                                    <Border x:Name="StatusPill" Style="{StaticResource Pill}" Margin="0,17,0,0"
                                            Background="#14FFFFFF" BorderBrush="#22FFFFFF">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{StaticResource TextFaintBrush}"/>
                                            <TextBlock x:Name="StatusText" Text="KONTROL EDİLİYOR" Margin="7,0,0,0"
                                                       FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextDimBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="StatusDetail" Margin="0,12,0,0" TextWrapping="Wrap"
                                               FontSize="12.5" LineHeight="18" Foreground="{StaticResource TextDimBrush}"
                                               Text="Tünel durumu okunuyor…"/>

                                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}"
                                            Margin="0,16,0,0" Content="Kur ve Bağlan"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="StatusBtn" Style="{StaticResource GhostButton}" Content="Durum"
                                                Margin="0,0,8,0" ToolTip="Ayrıntılı sağlık kontrolü"/>
                                        <Button x:Name="HealBtn" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Content="Onar" Margin="0,0,8,0"
                                                ToolTip="Bozulan parçayı bul ve onar"/>
                                        <Button x:Name="DiagBtn" Grid.Column="2" Style="{StaticResource GhostButton}"
                                                Content="Tanı"
                                                ToolTip="Neden çalışmıyor? Ayrıntılı teşhis"/>
                                    </Grid>

                                    <Grid Margin="0,17,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Divider}" VerticalAlignment="Center"/>
                                        <Button x:Name="AdvancedToggle" Grid.Column="1" Style="{StaticResource LinkButton}"
                                                Margin="10,-4,0,-4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="AdvancedLabel" Text="Gelişmiş" FontSize="11.5"
                                                           VerticalAlignment="Center"/>
                                                <Path x:Name="AdvancedChevron" Data="M 0,0 L 4,4 L 8,0" Margin="6,1,0,0"
                                                      Stroke="{StaticResource TextFaintBrush}" StrokeThickness="1.2"
                                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="MOTOR"/>
                                        <Border Style="{StaticResource SegmentedHost}" Margin="0,7,0,0">
                                            <UniformGrid Columns="3">
                                                <RadioButton x:Name="ModeAuto" Style="{StaticResource SegmentRadio}"
                                                             Content="Otomatik" GroupName="Mode" IsChecked="True"
                                                             ToolTip="Önce WARP'ı dener, engelliyse DPI motoruna geçer"/>
                                                <RadioButton x:Name="ModeWarp" Style="{StaticResource SegmentRadio}"
                                                             Content="WARP" GroupName="Mode"
                                                             ToolTip="Yalnızca Cloudflare WARP tüneli"/>
                                                <RadioButton x:Name="ModeDpi" Style="{StaticResource SegmentRadio}"
                                                             Content="DPI" GroupName="Mode"
                                                             ToolTip="Yalnızca TLS kayıt parçalama (IP gizlenmez)"/>
                                            </UniformGrid>
                                        </Border>

                                        <CheckBox x:Name="ForceCheck" Style="{StaticResource SwitchCheck}" Margin="0,14,0,0"
                                                  Content="Yeni ücretsiz WARP cihazı kaydet"/>
                                        <CheckBox x:Name="KeepDnsCheck" Style="{StaticResource SwitchCheck}" Margin="0,10,0,0"
                                                  Content="Sistem DNS'ine dokunma"/>

                                        <TextBlock Style="{StaticResource SectionLabel}" Text="UÇ (İSTEĞE BAĞLI)" Margin="0,14,0,0"/>
                                        <TextBox x:Name="EndpointBox" Style="{StaticResource InputBox}" Margin="0,7,0,0"
                                                 Tag="162.159.192.1:2408"/>

                                        <TextBlock Style="{StaticResource SectionLabel}" Text="KURULUM YÖNTEMİ" Margin="0,14,0,0"/>
                                        <Border Style="{StaticResource SegmentedHost}" Margin="0,7,0,0">
                                            <UniformGrid Columns="2">
                                                <RadioButton x:Name="MethodApp" Style="{StaticResource SegmentRadio}"
                                                             Content="Uygulama ile" GroupName="InstallMethod" IsChecked="True"
                                                             ToolTip="Kurulum bu pencerede çalışır, adımları canlı görürsün"/>
                                                <RadioButton x:Name="MethodManual" Style="{StaticResource SegmentRadio}"
                                                             Content="Elle (WarpCord.bat)" GroupName="InstallMethod"
                                                             ToolTip="Klasik kurulum ayrı bir komut penceresinde çalışır"/>
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock x:Name="MethodNote" Style="{StaticResource Faint}" Margin="0,8,0,0"
                                                   LineHeight="17"
                                                   Text="Kurulum bu pencerede çalışır; adımları canlı görürsün."/>
                                        <Button x:Name="ManualInstallBtn" Style="{StaticResource GhostButton}"
                                                Content="Klasik kurulumu başlat" Margin="0,10,0,0"
                                                Visibility="Collapsed"/>

                                        <Border Style="{StaticResource Divider}" Margin="0,16,0,14"/>
                                        <Button x:Name="UninstallBtn" Style="{StaticResource DangerButton}" Content="Kurulumu kaldır"
                                               />
                                    </StackPanel>
                                </StackPanel>
                            </Border>


                            <Border x:Name="InfoCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0"
                                    Padding="18,15,18,11" Background="#FF0D1019">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="NASIL ÇALIŞIR"/>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="21" Height="21" CornerRadius="11" Background="#1A22D3EE"
                                                    VerticalAlignment="Top" Margin="0,1,0,0">
                                                <TextBlock Text="1" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource CyanBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                <TextBlock Text="Tüneli kur" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" LineHeight="17"
                                                           Text="sing-box + wintun indirilir, ücretsiz WARP cihazı kaydedilir, çalışan motor seçilir."/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="21" Height="21" CornerRadius="11" Background="#1AA78BFA"
                                                    VerticalAlignment="Top" Margin="0,1,0,0">
                                                <TextBlock Text="2" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource VioletBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                <TextBlock Text="Yalnızca Discord tünellenir" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" LineHeight="17"
                                                           Text="discord.com ve Discord.exe akışları tünelden çıkar; DNS tünelin içinde çözülür."/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="21" Height="21" CornerRadius="11" Background="#1A34D399"
                                                    VerticalAlignment="Top" Margin="0,1,0,0">
                                                <TextBlock Text="3" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource GreenBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                <TextBlock Text="Geri kalan her şey doğrudan" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" LineHeight="17"
                                                           Text="Oyunlar, indirmeler ve yerel servisler etkilenmez; ping ve IP değişmez."/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Divider}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,-4,0,-4">
                                            <Button x:Name="TunnelLogBtn" Style="{StaticResource LinkButton}"
                                                    Content="Tünel günlüğü" ToolTip="tunnel.log dosyasını aç"/>
                                            <Button x:Name="HealLogBtn" Style="{StaticResource LinkButton}"
                                                    Content="Onarım günlüğü" Margin="8,0,0,0"
                                                    ToolTip="heal.log dosyasını aç"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- === right column === -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Padding="18,14,14,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="CANLI DURUM"/>
                                    <TextBlock x:Name="UpdatedText" Grid.Column="1" Style="{StaticResource Faint}"
                                               FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="güncelleniyor…"/>
                                    <Button x:Name="RefreshBtn" Grid.Column="2" Style="{StaticResource IconButton}"
                                            ToolTip="Şimdi yenile">
                                        <Grid Width="16" Height="16">
                                            <Path Data="M 13.2,5.2 A 6.2,6.2 0 1 0 14,8" Stroke="{StaticResource TextFaintBrush}"
                                                  StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Fill="Transparent"/>
                                            <Path Data="M 10.6,5.2 L 13.6,5.2 L 13.6,2.2" Stroke="{StaticResource TextFaintBrush}"
                                                  StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Fill="Transparent"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <ItemsControl x:Name="StatsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="29">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextFaintBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <Ellipse Grid.Column="2" Width="6" Height="6" VerticalAlignment="Center"
                                                         Margin="10,0,3,0" Fill="{Binding Dot}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,3,0,0" Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SparkLabel" Text="API gecikmesi" FontSize="11.5"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}"/>
                                    <local:Sparkline x:Name="LatencySpark" Grid.Column="1" Height="20" Margin="0,0,3,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,13,12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SegmentedHost}" Padding="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="TabAction" Style="{StaticResource SegmentRadio}"
                                                         Content="İşlem" GroupName="LogTab" IsChecked="True" Height="24" FontSize="11"/>
                                            <RadioButton x:Name="TabTunnel" Style="{StaticResource SegmentRadio}"
                                                         Content="Tünel" GroupName="LogTab" Height="24" FontSize="11"/>
                                            <RadioButton x:Name="TabRepair" Style="{StaticResource SegmentRadio}"
                                                         Content="Onarım" GroupName="LogTab" Height="24" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="RunPill" Grid.Column="1" Style="{StaticResource Pill}" Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            Padding="8,2,9,2" Background="#12FFFFFF" BorderBrush="#22FFFFFF" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="RunPillDot" Width="5" Height="5" VerticalAlignment="Center"
                                                     Fill="{StaticResource CyanBrush}"/>
                                            <TextBlock x:Name="RunPillText" Text="çalışıyor" Margin="6,0,0,0" FontSize="10"
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="CopyBtn" Grid.Column="2" Style="{StaticResource LinkButton}" Content="Kopyala"
                                           />
                                    <Button x:Name="ClearBtn" Grid.Column="3" Style="{StaticResource LinkButton}" Content="Temizle"
                                            Margin="4,0,0,0"/>
                                    <CheckBox x:Name="AutoscrollCheck" Grid.Column="4" Style="{StaticResource SwitchCheck}"
                                              IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center"
                                              ToolTip="Yeni satırlarda en alta kaydır">
                                        <TextBlock Text="kaydır" FontSize="11" Foreground="{StaticResource TextFaintBrush}"/>
                                    </CheckBox>
                                </Grid>

                                <Grid Grid.Row="1" x:Name="RunStepHost" Visibility="Collapsed" Margin="0,7,4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="Spinner" Width="13" Height="13" VerticalAlignment="Center">
                                        <Ellipse Width="13" Height="13" Stroke="#22FFFFFF" StrokeThickness="2"/>
                                        <Path Data="M 6.5,0 A 6.5,6.5 0 0 1 13,6.5" Stroke="{StaticResource CyanBrush}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <TextBlock x:Name="RunStep" Grid.Column="1" Margin="9,0,0,0" FontSize="11.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource CyanBrush}" Text="hazırlanıyor…"/>
                                    <Button x:Name="CancelBtn" Grid.Column="2" Style="{StaticResource LinkButton}"
                                            Content="İptal" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <RichTextBox x:Name="ConsoleBox" IsReadOnly="True" IsDocumentEnabled="False"
                                                 IsReadOnlyCaretVisible="False" BorderThickness="0" Padding="0"
                                                 Background="Transparent" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled" IsTabStop="False"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                 Foreground="{StaticResource TextDimBrush}">
                                        <FlowDocument PagePadding="0" TextAlignment="Left">
                                            <Paragraph Margin="0" LineHeight="16.5" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                                        </FlowDocument>
                                    </RichTextBox>
                                    <TextBlock x:Name="ConsoleEmpty" TextWrapping="Wrap" Margin="2,2,10,0" IsHitTestVisible="False"
                                               FontSize="12" LineHeight="19" Foreground="{StaticResource TextFaintBrush}"
                                               Text="Kurulum, onarım ve teşhis çıktısı burada akar. Başlamak için soldaki düğmeyi kullan."/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ======================================================= statusbar -->
            <Border Grid.Row="2" Background="#FF0B0E19" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="AdminDot" Width="6" Height="6" Fill="{StaticResource TextFaintBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="AdminText" Text="yönetici değil" Margin="7,0,0,0" FontSize="10.5"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}"/>
                        <Border Width="1" Height="11" Background="{StaticResource StrokeBrush}" Margin="12,0"/>
                        <TextBlock x:Name="RepoText" Text="—" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis"
                                   MaxWidth="520"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DiscordBtn" Style="{StaticResource LinkButton}" Content="Discord'u yeniden başlat"/>
                        <Border Width="1" Height="11" Background="{StaticResource StrokeBrush}" Margin="10,0"/>
                        <Button x:Name="FolderBtn" Style="{StaticResource LinkButton}" Content="Klasörü aç"/>
                        <Border Width="1" Height="11" Background="{StaticResource StrokeBrush}" Margin="10,0"/>
                        <TextBlock x:Name="VersionText" Text="—" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextFaintBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Grid>