{
  "log": {
    "level": "info",
    "timestamp": true,
    "output": "C:\\ProgramData\\DiscordTunnel\\tunnel.log"
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "doh",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "frag"
      }
    ],
    "final": "doh",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "WarpCord",
      "address": [
        "172.19.0.1/30"
      ],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": false,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "http",
      "tag": "frag",
      "server": "127.0.0.1",
      "server_port": 1081
    }
  ],
  "route": {
    "default_domain_resolver": "doh",
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "network": "tcp",
        "domain_suffix": [
          "discord.com",
          "discord.gg",
          "discordapp.com",
          "discordapp.net",
          "discord.media",
          "discordstatus.com",
          "discord.co",
          "discordapp.io",
          "discordsays.com",
          "discordmerch.com"
        ],
        "outbound": "frag"
      },
      {
        "network": "tcp",
        "process_name": [
          "Discord.exe",
          "DiscordPTB.exe",
          "DiscordCanary.exe",
          "DiscordDevelopment.exe",
          "Update.exe"
        ],
        "outbound": "frag"
      },
      {
        "network": "tcp",
        "process_path_regex": [
          "(?i).*[\\\\/]Discord[\\\\/].*"
        ],
        "outbound": "frag"
      }
    ],
    "final": "direct"
  }
}